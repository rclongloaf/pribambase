# Optional. The development runner auto-detects Blender on common locations.
# Set this when Blender is installed elsewhere.
# BLENDER_EXECUTABLE=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# Optional DAP endpoint used by `.\dev.ps1 debug`.
# BLENDER_DEBUG_HOST=127.0.0.1
# BLENDER_DEBUG_PORT=5678

# Optional. The extension runner auto-detects Aseprite on common locations.
# ASEPRITE_EXECUTABLE=C:\Program Files\Aseprite\Aseprite.exe

# Optional override for Aseprite's profile directory (official Aseprite variable).
# ASEPRITE_USER_FOLDER=C:\Users\user\AppData\Roaming\Aseprite
